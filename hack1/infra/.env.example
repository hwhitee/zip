# ─────────────────────────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wardsentinel
POSTGRES_USER=wardsentinel
POSTGRES_PASSWORD=changeme_dev_only

# ─────────────────────────────────────────────────────────────
#  Spring Boot Backend
# ─────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wardsentinel
SPRING_DATASOURCE_USERNAME=wardsentinel
SPRING_DATASOURCE_PASSWORD=changeme_dev_only

# Internal URL of the Python inference service (backend → inference)
INFERENCE_SERVICE_URL=http://localhost:8001

# ─────────────────────────────────────────────────────────────
#  Inference Service (FastAPI)
# ─────────────────────────────────────────────────────────────
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8001
INFERENCE_MODEL_VERSION=v0.1.0-heuristic

# ─────────────────────────────────────────────────────────────
#  Google Gemini API  (OPTIONAL — system works without this)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─────────────────────────────────────────────────────────────
#  Frontend (Next.js)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# ─────────────────────────────────────────────────────────────
#  pgAdmin (Docker only — for local DB browsing)
# ─────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@wardsentinel.local
PGADMIN_DEFAULT_PASSWORD=admin
